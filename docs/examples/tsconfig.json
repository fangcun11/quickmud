{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@mud/ecs-engine": [
        "../../packages/engine/src/index.ts"
      ],
      "@mud/ecs-engine/testing": [
        "../../packages/engine/src/testing.ts"
      ],
      "@mud/prefabs": [
        "../../packages/prefabs/src/index.ts"
      ]
    },
    "types": [
      "node"
    ],
    "typeRoots": [
      "../../packages/engine/node_modules/@types"
    ]
  },
  "include": [
    "*.mts",
    "*.test.ts"
  ]
}
